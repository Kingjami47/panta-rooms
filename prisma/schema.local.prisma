generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A Room is the social wrapper around a Panta market.
// The market itself lives in Panta's catalog (marketId = event PDA).
// demo=true marks rooms created in DEMO MODE (no real Panta market).
model Room {
  id          String   @id @default(cuid())
  marketId    String   @unique // Panta marketId; for demo rooms: "demo:<cuid>"
  category    String   @default("other")
  title       String
  description String?
  imageUrl    String?
  creatorName String   @default("Anonymous")
  creatorWallet String?
  demo        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
}

model Comment {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  wallet      String? // commenter wallet (live) or null (demo/guest)
  displayName String   @default("Guest")
  body        String
  createdAt   DateTime @default(now())
  reactions   Reaction[]
}

model Reaction {
  id        String  @id @default(cuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  emoji     String
  wallet    String
  @@unique([commentId, wallet, emoji])
}

// Learned market metadata (real question title, description, cover image).
// Panta's list endpoint returns title:"" for most rows and its detail endpoint
// flips between a complete and a stripped shape (audit 2026-09-27, re-verified
// 2026-10-01), so titles must be re-rolled until a complete read succeeds.
// In-memory caches are per-serverless-instance and die on cold starts/instance
// churn — this shared table is what makes a learned title stick for ALL
// instances. Rows are only ever written from COMPLETE reads (never fallback
// labels), so a stored title cannot regress.
model MarketMeta {
  marketId    String   @id
  title       String
  description String?
  imageUrl    String?
  updatedAt   DateTime @updatedAt
}
