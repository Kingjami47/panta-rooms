# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets — NEVER commit (Panta live/test API keys)
/scripts/panta_key*.json

# user uploads + local session artifacts
/upload/
/tool-results/
db/custom.db-journal

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# internal agent worklog + workspace artifacts (kept locally, never pushed)
/worklog.md
/download/

# template residue not part of the app
/examples/
/mini-services/

# dev-session screenshots (verification artifacts)
/scripts/*.png

# old git history backup — contains pre-rotation history; NEVER push
/.git-pre-clean-backup/

# nested screenshot dir
/scripts/shots/
/.zscripts/
