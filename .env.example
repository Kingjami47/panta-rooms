# ─────────────────────────────────────────────────────────────────────────────
# Panta Rooms — environment variables
#
# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production / Preview).
# NEVER put real secret values in this file or in any client-side code.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for full Mainnet Mode (server-only, never exposed to browser) ──
# Panta LIVE API key (pk_live_…) → Solana mainnet markets, real USDC.
# Without it the app still runs: live mode is unavailable and the switcher
# honestly falls back to Sandbox/Demo (see src/server/request-mode.ts).
PANTA_API_KEY=

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Panta TEST key (pk_test_…) → Panta sandbox FIXTURES (not a blockchain).
# Enables the "Sandbox" entry in the environment switcher.
PANTA_API_KEY_TEST=

# Panta API base URL. Default: https://live-api.panta.market/api/v1 (do not
# change unless Panta itself tells you to — no devnet/testnet exists).
# PANTA_API_BASE_URL=

# Legacy server-wide default mode ("live" | "test") when the user has not
# picked an environment yet. Default: live.
# PANTA_MODE=

# Solana RPC endpoint (server-side balance reads).
# Default: https://api.mainnet-beta.solana.com — the public RPC is
# rate-limited; a dedicated mainnet endpoint (e.g. Helius/QuickNode) is
# recommended for production traffic.
# SOLANA_RPC_URL=

# Solana RPC endpoint used by the wallet-adapter Connection in the browser.
# Default: https://api.mainnet-beta.solana.com (inlined at BUILD time).
# NEXT_PUBLIC_SOLANA_RPC=

# USDC mint override. Default: canonical native USDC on Solana mainnet
# (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v). Keep the default unless
# you have an explicit reason.
# USDC_MINT=
# NEXT_PUBLIC_USDC_MINT=

# Canonical app origin for SSR fallbacks + OG/canonical metadata.
# Default: https://panterrooms.xyz
# NEXT_PUBLIC_APP_URL=

# SQLite storage for rooms/comments/reactions.
# Local dev default lives in .env (gitignored). In serverless deployments
# leave this UNSET: the app seeds a writable copy under /tmp automatically.
# DATABASE_URL=
